{
  "name": "xparty",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Code-only private watch rooms for PKX404",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server.mjs && node --check public/xparty/app.js",
    "build:android-providers": "esbuild public/xparty/providers.js --bundle --format=iife --global-name=XPartyProviders --target=chrome69 --outfile=android-native/app/build/generated/roomAssets/providers/providers.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@supabase/supabase-js": "2.117.2",
    "esbuild": "0.25.12"
  }
}
